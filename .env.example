# Keep comments on their own lines: the Makefile includes this file, and make
# would treat an inline comment's leading spaces as part of the value.

# Profiles to start: llm, gateway, vector, observability, db, cache
COMPOSE_PROFILES=llm,vector,observability

# --- Ollama ---
# Space-separated list of models pulled on startup
OLLAMA_MODELS_TO_PULL=qwen3:8b nomic-embed-text
# Concurrent requests served per loaded model
OLLAMA_NUM_PARALLEL=2
# Models kept in memory at the same time
OLLAMA_MAX_LOADED_MODELS=2
# How long an idle model stays loaded
OLLAMA_KEEP_ALIVE=30m

# --- ChromaDB ---
# Host port (8000 is used by simple-ai-agent); containers always use 8000
CHROMA_HOST_PORT=8001

# --- LiteLLM (profile: gateway) ---
LITELLM_HOST_PORT=4000
# Local-only dev key; change it if you expose the gateway
LITELLM_MASTER_KEY=sk-local-dev

# --- Postgres + pgvector (profile: db) ---
POSTGRES_HOST_PORT=5432
POSTGRES_USER=postgres
# Local-only dev password
POSTGRES_PASSWORD=postgres
POSTGRES_DB=app

# --- Redis (profile: cache) ---
REDIS_HOST_PORT=6379

# --- Phoenix (profile: observability) ---
# Host port for the Phoenix UI and REST API
PHOENIX_HOST_PORT=6006

# --- Azure Monitor (optional, docker-compose.azure.yml) ---
# Also send traces to Application Insights, shown in Microsoft Foundry. Get the
# connection string (an ingestion key: keep it out of git) with:
#   az monitor app-insights component show -a <name> -g <resource-group> --query connectionString -o tsv
# APPLICATIONINSIGHTS_CONNECTION_STRING=
# Uncomment to load the override with every `docker compose` / `make` command.
# The separator is the OS path separator: ':' on Linux/macOS/WSL, ';' on Windows.
# COMPOSE_FILE=docker-compose.yml:docker-compose.azure.yml
